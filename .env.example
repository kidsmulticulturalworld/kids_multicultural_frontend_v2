# ── Django API (existing) ──
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Sanity (non-sensitive — required by Studio / image CDN in the browser) ──
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# ── Sanity secrets (server-only — NEVER prefix with NEXT_PUBLIC_) ──
# Create a Viewer token at https://www.sanity.io/manage → API → Tokens
SANITY_API_READ_TOKEN=
# Shared secret for the /api/revalidate webhook (set the same value in Sanity)
SANITY_REVALIDATE_SECRET=

# Optional site URL for absolute OG / sitemap URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
